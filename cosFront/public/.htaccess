# SPA (React / React Router) — même idée que nginx try_files … /index.html
# Sans ça, un F5 sur /spectator/ ou /spectator/?mode=favorites renvoie 404 Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
